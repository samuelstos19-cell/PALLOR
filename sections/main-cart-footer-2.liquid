{%- style -%}
  /* ================================================================
     PALLØR — CART FOOTER
     Precise. Cold. No decoration. The number is the statement.
     ================================================================ */

  .pallor-cart-footer {
    --p-black:   #080709;
    --p-deep:    #0d0b10;
    --p-surface: #111018;
    --p-line:    #1e1c2a;
    --p-muted:   #2e2b3e;
    --p-text-1:  #eae6df;
    --p-text-2:  #b8b4ac;
    --p-text-3:  #706c7a;
    --p-text-4:  #3a3748;
    --p-accent:  #c8c2b8;
    --p-bruise:  #231f30;
    --p-font-serif: 'Cormorant Garamond', Georgia, serif;
    --p-font-mono:  'Fragment Mono', 'Courier New', monospace;
    --p-font-sans:  'Jost', 'Helvetica Neue', sans-serif;
    --p-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --p-ease-mid: cubic-bezier(0.25, 0.1, 0.25, 1);
    --p-t-mid: 420ms;
  }

  /* Footer wrapper */
  .pallor-cart-footer .cart__footer {
    background-color: var(--p-surface);
    border-top: 1px solid var(--p-line);
    padding-top: 3.2rem;
    position: relative;
  }
  /* Top-left corner accent */
  .pallor-cart-footer .cart__footer::before {
    content: '';
    position: absolute;
    top: -1px; left: 0;
    width: 2.8rem; height: 2.8rem;
    border-top: 1px solid var(--p-accent);
    border-left: 1px solid var(--p-accent);
    opacity: 0.3;
    pointer-events: none;
  }

  /* Cart note */
  .pallor-cart-footer .cart__note { border-top: 1px solid var(--p-line); padding-top: 2.4rem; margin-bottom: 3.2rem; }
  .pallor-cart-footer .cart__note label {
    font-family: var(--p-font-mono) !important;
    font-size: 0.78rem !important; letter-spacing: 0.24em !important;
    text-transform: uppercase !important; color: var(--p-text-4) !important;
    display: block; margin-bottom: 1rem;
  }
  .pallor-cart-footer .cart__note .text-area {
    font-family: var(--p-font-sans) !important;
    font-size: 1.3rem !important; font-weight: 300 !important;
    color: var(--p-text-2) !important; background-color: var(--p-deep) !important;
    border: 1px solid var(--p-line) !important; border-radius: 0 !important;
    resize: vertical; transition: border-color var(--p-t-mid) var(--p-ease-mid);
    letter-spacing: 0.04em;
  }
  .pallor-cart-footer .cart__note .text-area:focus { border-color: var(--p-accent) !important; outline: none; }
  .pallor-cart-footer .cart__note .text-area::placeholder { color: var(--p-text-4); }

  /* Totals */
  .pallor-cart-footer .totals {
    display: flex; align-items: baseline;
    justify-content: space-between; gap: 2rem;
    padding: 2.6rem 0;
    border-top: 1px solid var(--p-line);
  }
  .pallor-cart-footer .totals__subtotal {
    font-family: var(--p-font-mono) !important;
    font-size: 0.78rem !important; font-weight: 400 !important;
    letter-spacing: 0.28em !important; text-transform: uppercase !important;
    color: var(--p-text-4) !important; margin: 0 !important;
  }
  .pallor-cart-footer .totals__subtotal-value {
    font-family: var(--p-font-serif) !important;
    font-size: 3rem !important; font-weight: 300 !important;
    letter-spacing: 0.06em !important; color: var(--p-text-1) !important; margin: 0 !important;
  }

  /* Discounts */
  .pallor-cart-footer .discounts { padding: 0 0 1.6rem; }
  .pallor-cart-footer .discounts__discount {
    font-family: var(--p-font-mono) !important;
    font-size: 0.82rem !important; letter-spacing: 0.14em !important;
    color: var(--p-accent) !important; display: flex; align-items: center; gap: 0.8rem;
  }

  /* Tax / shipping note */
  .pallor-cart-footer .tax-note {
    font-family: var(--p-font-sans) !important;
    font-size: 1.1rem !important; font-weight: 300 !important;
    letter-spacing: 0.04em !important; color: var(--p-text-4) !important;
    display: block; padding-bottom: 2.6rem; line-height: 1.75;
  }
  .pallor-cart-footer .tax-note a { color: var(--p-text-3); border-bottom: 1px solid var(--p-line); transition: color var(--p-t-mid), border-color var(--p-t-mid); }
  .pallor-cart-footer .tax-note a:hover { color: var(--p-accent); border-color: rgba(200,194,184,0.3); }

  /* Checkout button — inverted, the most visible element */
  .pallor-cart-footer .cart__checkout-button {
    font-family: var(--p-font-mono) !important;
    font-weight: 400 !important; font-size: 0.88rem !important;
    letter-spacing: 0.28em !important; text-transform: uppercase !important;
    background-color: var(--p-text-1) !important;
    color: var(--p-black) !important;
    border: 1px solid var(--p-text-1) !important;
    border-radius: 0 !important;
    padding: 2rem 4rem !important; width: 100%;
    transition: background-color var(--p-t-mid) var(--p-ease-mid),
                border-color var(--p-t-mid) var(--p-ease-mid),
                transform var(--p-t-mid) var(--p-ease-mid) !important;
    position: relative; overflow: hidden;
  }
  .pallor-cart-footer .cart__checkout-button:hover {
    background-color: var(--p-accent) !important;
    border-color: var(--p-accent) !important;
    transform: translateY(-1px);
  }
  .pallor-cart-footer .cart__checkout-button:active { transform: translateY(0) !important; }
  .pallor-cart-footer .cart__checkout-button[disabled] {
    background-color: var(--p-line) !important;
    border-color: var(--p-line) !important;
    color: var(--p-text-4) !important;
    cursor: not-allowed; transform: none !important;
  }

  /* Update button */
  .pallor-cart-footer .cart__update-button {
    font-family: var(--p-font-mono) !important;
    font-size: 0.88rem !important; letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    background-color: transparent !important;
    color: var(--p-text-4) !important;
    border: 1px solid var(--p-line) !important;
    border-radius: 0 !important; width: 100%; margin-bottom: 1.2rem;
    transition: border-color var(--p-t-mid), color var(--p-t-mid);
  }
  .pallor-cart-footer .cart__update-button:hover { border-color: var(--p-muted) !important; color: var(--p-text-3) !important; }

  /* Dynamic checkout */
  .pallor-cart-footer .cart__dynamic-checkout-buttons {
    margin-top: 1.2rem; padding-top: 1.6rem; border-top: 1px solid var(--p-line);
  }
  .pallor-cart-footer .shopify-payment-button__button--unbranded {
    background-color: transparent !important; color: var(--p-text-3) !important;
    border: 1px solid var(--p-line) !important; border-radius: 0 !important;
    font-family: var(--p-font-mono) !important; font-size: 0.88rem !important;
    letter-spacing: 0.22em !important; text-transform: uppercase !important;
    transition: border-color var(--p-t-mid), color var(--p-t-mid) !important;
  }
  .pallor-cart-footer .shopify-payment-button__button--unbranded:hover {
    border-color: var(--p-text-3) !important; color: var(--p-text-2) !important;
  }

  /* CTAs wrapper */
  .pallor-cart-footer .cart__ctas { display: flex; flex-direction: column; gap: 1.2rem; }

  /* Error messages */
  .pallor-cart-footer #cart-errors {
    font-family: var(--p-font-mono) !important;
    font-size: 0.82rem !important; letter-spacing: 0.1em !important;
    color: var(--p-accent) !important; padding: 1.2rem 0;
  }

  /* Entry animation */
  @keyframes pallor-footer-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .pallor-cart-footer .cart__footer { animation: pallor-footer-rise 0.8s cubic-bezier(0.22,1,0.36,1) both; }

  @media (prefers-reduced-motion: reduce) {
    .pallor-cart-footer *, .pallor-cart-footer *::before, .pallor-cart-footer *::after {
      animation-duration: 0.01ms !important; transition-duration: 0.01ms !important;
    }
  }
{%- endstyle -%}

<div class="pallor-cart-footer page-width{% if cart == empty %} is-empty{% endif %}" id="main-cart-footer" data-id="{{ section.id }}">
  <div>
    <div class="cart__footer">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea class="text-area field__input" name="note" form="cart" id="Cart-note" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}{% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div class="totals">
                  <h2 class="totals__subtotal">{{ 'sections.cart.subtotal' | t }}</h2>
                  <p class="totals__subtotal-value">{{ cart.total_price | money_with_currency }}</p>
                </div>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {%- render 'icon-discount' -%}{{ discount.title }} (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
                <small class="tax-note caption-large rte">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <noscript>
                  <button type="submit" class="cart__update-button button button--secondary" form="cart">
                    {{ 'sections.cart.update' | t }}
                  </button>
                </noscript>
                <button type="submit" id="checkout" class="cart__checkout-button button" name="checkout" {% if cart == empty %}disabled{% endif %} form="cart">
                  {{ 'sections.cart.checkout' | t }}
                </button>
              </div>
              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}
        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isIE() {
      const ua = window.navigator.userAgent;
      return ua.indexOf('MSIE ') > 0 || ua.indexOf('Trident/') > 0;
    }
    if (!isIE()) return;
    const cartSubmitInput = document.createElement('input');
    cartSubmitInput.setAttribute('name', 'checkout');
    cartSubmitInput.setAttribute('type', 'hidden');
    document.querySelector('#cart').appendChild(cartSubmitInput);
    document.querySelector('#checkout').addEventListener('click', function () {
      document.querySelector('#cart').submit();
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "blocks": [
    { "type": "subtotal", "name": "t:sections.main-cart-footer.blocks.subtotal.name", "limit": 1 },
    { "type": "buttons", "name": "t:sections.main-cart-footer.blocks.buttons.name", "limit": 1 },
    { "type": "@app" }
  ]
}
{% endschema %}
