{% include 'shogun-content-handler' %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#080709">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <!--
      PALLØR Typefaces:
      Cormorant Garamond — high-contrast editorial serif (headings, titles, display)
      Fragment Mono      — clinical monospace (nav, labels, buttons, SKU)
      Jost               — geometric light sans (body copy, descriptions)
    -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Fragment+Mono&family=Jost:wght@100;200;300;400&display=swap" rel="stylesheet">

    {{ 'pl--styles.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'pl--base.css' | asset_url | stylesheet_tag: preload: true }}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pl--base.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      /* ================================================================
         PALLØR — DARK LUXURY STREETWEAR
         The rejection of perfection, executed with total precision.
         One black. Sharp corners. Fragile type. The broken moth.
         ================================================================ */

      :root {
        /* Shopify token passthrough */
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};
        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};
        --color-base-text: {{ settings.colors_text.red }}, {{ settings.colors_text.green }}, {{ settings.colors_text.blue }};
        --color-shadow: {{ settings.colors_text.red }}, {{ settings.colors_text.green }}, {{ settings.colors_text.blue }};
        --color-base-background-1: {{ settings.colors_background_1.red }}, {{ settings.colors_background_1.green }}, {{ settings.colors_background_1.blue }};
        --color-base-background-2: {{ settings.colors_background_2.red }}, {{ settings.colors_background_2.green }}, {{ settings.colors_background_2.blue }};
        --color-base-solid-button-labels: {{ settings.colors_solid_button_labels.red }}, {{ settings.colors_solid_button_labels.green }}, {{ settings.colors_solid_button_labels.blue }};
        --color-base-outline-button-labels: {{ settings.colors_outline_button_labels.red }}, {{ settings.colors_outline_button_labels.green }}, {{ settings.colors_outline_button_labels.blue }};
        --color-base-accent-1: {{ settings.colors_accent_1.red }}, {{ settings.colors_accent_1.green }}, {{ settings.colors_accent_1.blue }};
        --color-base-accent-2: {{ settings.colors_accent_2.red }}, {{ settings.colors_accent_2.green }}, {{ settings.colors_accent_2.blue }};
        --payment-terms-background-color: {{ settings.colors_background_1 }};
        --gradient-base-background-1: {% if settings.gradient_background_1 != blank %}{{ settings.gradient_background_1 }}{% else %}{{ settings.colors_background_1 }}{% endif %};
        --gradient-base-background-2: {% if settings.gradient_background_2 != blank %}{{ settings.gradient_background_2 }}{% else %}{{ settings.colors_background_2 }}{% endif %};
        --gradient-base-accent-1: {% if settings.gradient_accent_1 != blank %}{{ settings.gradient_accent_1 }}{% else %}{{ settings.colors_accent_1 }}{% endif %};
        --gradient-base-accent-2: {% if settings.gradient_accent_2 != blank %}{{ settings.gradient_accent_2 }}{% else %}{{ settings.colors_accent_2 }}{% endif %};
        --media-padding: {{ settings.media_padding }}px;
        --media-border-opacity: {{ settings.media_border_opacity | divided_by: 100.0 }};
        --media-border-width: {{ settings.media_border_thickness }}px;
        --media-radius: {{ settings.media_radius }}px;
        --media-shadow-opacity: {{ settings.media_shadow_opacity | divided_by: 100.0 }};
        --media-shadow-horizontal-offset: {{ settings.media_shadow_horizontal_offset }}px;
        --media-shadow-vertical-offset: {{ settings.media_shadow_vertical_offset }}px;
        --media-shadow-blur-radius: {{ settings.media_shadow_blur }}px;
        --media-shadow-visible: {% if settings.media_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --page-width: {{ settings.page_width | divided_by: 10 }}rem;
        --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;
        --product-card-image-padding: {{ settings.card_image_padding | divided_by: 10.0 }}rem;
        --product-card-corner-radius: {{ settings.card_corner_radius | divided_by: 10.0 }}rem;
        --product-card-text-alignment: {{ settings.card_text_alignment }};
        --product-card-border-width: {{ settings.card_border_thickness | divided_by: 10.0 }}rem;
        --product-card-border-opacity: {{ settings.card_border_opacity | divided_by: 100.0 }};
        --product-card-shadow-opacity: {{ settings.card_shadow_opacity | divided_by: 100.0 }};
        --product-card-shadow-visible: {% if settings.card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --product-card-shadow-horizontal-offset: {{ settings.card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --product-card-shadow-vertical-offset: {{ settings.card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --product-card-shadow-blur-radius: {{ settings.card_shadow_blur | divided_by: 10.0 }}rem;
        --collection-card-image-padding: {{ settings.collection_card_image_padding | divided_by: 10.0 }}rem;
        --collection-card-corner-radius: {{ settings.collection_card_corner_radius | divided_by: 10.0 }}rem;
        --collection-card-text-alignment: {{ settings.collection_card_text_alignment }};
        --collection-card-border-width: {{ settings.collection_card_border_thickness | divided_by: 10.0 }}rem;
        --collection-card-border-opacity: {{ settings.collection_card_border_opacity | divided_by: 100.0 }};
        --collection-card-shadow-opacity: {{ settings.collection_card_shadow_opacity | divided_by: 100.0 }};
        --collection-card-shadow-visible: {% if settings.collection_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --collection-card-shadow-horizontal-offset: {{ settings.collection_card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --collection-card-shadow-vertical-offset: {{ settings.collection_card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --collection-card-shadow-blur-radius: {{ settings.collection_card_shadow_blur | divided_by: 10.0 }}rem;
        --blog-card-image-padding: {{ settings.blog_card_image_padding | divided_by: 10.0 }}rem;
        --blog-card-corner-radius: {{ settings.blog_card_corner_radius | divided_by: 10.0 }}rem;
        --blog-card-text-alignment: {{ settings.blog_card_text_alignment }};
        --blog-card-border-width: {{ settings.blog_card_border_thickness | divided_by: 10.0 }}rem;
        --blog-card-border-opacity: {{ settings.blog_card_border_opacity | divided_by: 100.0 }};
        --blog-card-shadow-opacity: {{ settings.blog_card_shadow_opacity | divided_by: 100.0 }};
        --blog-card-shadow-visible: {% if settings.blog_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --blog-card-shadow-horizontal-offset: {{ settings.blog_card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --blog-card-shadow-vertical-offset: {{ settings.blog_card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --blog-card-shadow-blur-radius: {{ settings.blog_card_shadow_blur | divided_by: 10.0 }}rem;
        --badge-corner-radius: {{ settings.badge_corner_radius | divided_by: 10.0 }}rem;
        --popup-border-width: {{ settings.popup_border_thickness }}px;
        --popup-border-opacity: {{ settings.popup_border_opacity | divided_by: 100.0 }};
        --popup-corner-radius: {{ settings.popup_corner_radius }}px;
        --popup-shadow-opacity: {{ settings.popup_shadow_opacity | divided_by: 100.0 }};
        --popup-shadow-horizontal-offset: {{ settings.popup_shadow_horizontal_offset }}px;
        --popup-shadow-vertical-offset: {{ settings.popup_shadow_vertical_offset }}px;
        --popup-shadow-blur-radius: {{ settings.popup_shadow_blur }}px;
        --drawer-border-width: {{ settings.drawer_border_thickness }}px;
        --drawer-border-opacity: {{ settings.drawer_border_opacity | divided_by: 100.0 }};
        --drawer-shadow-opacity: {{ settings.drawer_shadow_opacity | divided_by: 100.0 }};
        --drawer-shadow-horizontal-offset: {{ settings.drawer_shadow_horizontal_offset }}px;
        --drawer-shadow-vertical-offset: {{ settings.drawer_shadow_vertical_offset }}px;
        --drawer-shadow-blur-radius: {{ settings.drawer_shadow_blur }}px;
        --spacing-sections-desktop: {{ settings.spacing_sections }}px;
        --spacing-sections-mobile: {% if settings.spacing_sections < 24 %}{{ settings.spacing_sections }}{% else %}{{ settings.spacing_sections | times: 0.7 | round | at_least: 20 }}{% endif %}px;
        --grid-desktop-vertical-spacing: {{ settings.spacing_grid_vertical }}px;
        --grid-desktop-horizontal-spacing: {{ settings.spacing_grid_horizontal }}px;
        --grid-mobile-vertical-spacing: {{ settings.spacing_grid_vertical | divided_by: 2 }}px;
        --grid-mobile-horizontal-spacing: {{ settings.spacing_grid_horizontal | divided_by: 2 }}px;
        --text-boxes-border-opacity: {{ settings.text_boxes_border_opacity | divided_by: 100.0 }};
        --text-boxes-border-width: {{ settings.text_boxes_border_thickness }}px;
        --text-boxes-radius: {{ settings.text_boxes_radius }}px;
        --text-boxes-shadow-opacity: {{ settings.text_boxes_shadow_opacity | divided_by: 100.0 }};
        --text-boxes-shadow-visible: {% if settings.text_boxes_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --text-boxes-shadow-horizontal-offset: {{ settings.text_boxes_shadow_horizontal_offset }}px;
        --text-boxes-shadow-vertical-offset: {{ settings.text_boxes_shadow_vertical_offset }}px;
        --text-boxes-shadow-blur-radius: {{ settings.text_boxes_shadow_blur }}px;
        --buttons-radius: 0px;
        --buttons-radius-outset: 0px;
        --buttons-border-width: {% if settings.buttons_border_opacity > 0 %}{{ settings.buttons_border_thickness }}{% else %}0{% endif %}px;
        --buttons-border-opacity: {{ settings.buttons_border_opacity | divided_by: 100.0 }};
        --buttons-shadow-opacity: 0;
        --buttons-shadow-visible: 0;
        --buttons-shadow-horizontal-offset: 0px;
        --buttons-shadow-vertical-offset: 0px;
        --buttons-shadow-blur-radius: 0px;
        --buttons-border-offset: 0px;
        --inputs-radius: 0px;
        --inputs-border-width: {{ settings.inputs_border_thickness }}px;
        --inputs-border-opacity: {{ settings.inputs_border_opacity | divided_by: 100.0 }};
        --inputs-shadow-opacity: 0;
        --inputs-shadow-horizontal-offset: 0px;
        --inputs-margin-offset: 0px;
        --inputs-shadow-vertical-offset: 0px;
        --inputs-shadow-blur-radius: 0px;
        --inputs-radius-outset: 0px;
        --variant-pills-radius: 0px;
        --variant-pills-border-width: {{ settings.variant_pills_border_thickness }}px;
        --variant-pills-border-opacity: {{ settings.variant_pills_border_opacity | divided_by: 100.0 }};
        --variant-pills-shadow-opacity: 0;
        --variant-pills-shadow-horizontal-offset: 0px;
        --variant-pills-shadow-vertical-offset: 0px;
        --variant-pills-shadow-blur-radius: 0px;

        /* ═══════════════════════════════════════
           PALLØR COLOUR SYSTEM
           One definitive black. Cold accents only.
           "The anxiety. The scars. The doubt."
        ═══════════════════════════════════════ */

        /* The single void — everything lives on this */
        --p-black:        #080709;   /* THE black — never deviate */
        --p-deep:         #0d0b10;   /* page background — bruised dark */
        --p-surface:      #111018;   /* card / surface */
        --p-raised:       #171523;   /* elevated modal / drawer */
        --p-line:         #1e1c2a;   /* borders / dividers */
        --p-muted:        #2e2b3e;   /* muted elements */
        --p-dim:          #4a4660;   /* disabled / ghost */

        /* Text hierarchy — four levels */
        --p-text-1:       #eae6df;   /* primary — near-white, cool undertone */
        --p-text-2:       #b8b4ac;   /* secondary — warm grey */
        --p-text-3:       #706c7a;   /* tertiary — lavender-grey */
        --p-text-4:       #3a3748;   /* ghost — barely visible */

        /* The one accent — moth-wing pale */
        --p-accent:       #c8c2b8;   /* THE accent — used sparingly */
        --p-accent-dim:   rgba(200, 194, 184, 0.12);

        /* Bruise tones — for depth, never as backgrounds */
        --p-bruise:       #231f30;   /* deep purple-black */
        --p-violet:       #5e5870;   /* muted violet for variety */

        /* Typography system */
        --p-font-serif:  'Cormorant Garamond', 'Playfair Display', Georgia, serif;
        --p-font-mono:   'Fragment Mono', 'Courier New', monospace;
        --p-font-sans:   'Jost', 'Helvetica Neue', Arial, sans-serif;

        /* Motion — unhurried, deliberate */
        --p-ease-out:  cubic-bezier(0.22, 1, 0.36, 1);
        --p-ease-in:   cubic-bezier(0.4, 0, 1, 1);
        --p-ease-mid:  cubic-bezier(0.25, 0.1, 0.25, 1);
        --p-t-fast: 200ms;
        --p-t-mid:  420ms;
        --p-t-slow: 900ms;
      }

      /* ── Reset ── */
      *, *::before, *::after { box-sizing: inherit; }

      html {
        box-sizing: border-box;
        font-size: calc(var(--font-body-scale) * 62.5%);
        height: 100%;
        scroll-behavior: smooth;
        background-color: var(--p-black);
      }

      /* ── Selection ── */
      ::selection { background-color: var(--p-muted); color: var(--p-text-1); }

      /* ── Scrollbar — thin, cold ── */
      ::-webkit-scrollbar { width: 2px; }
      ::-webkit-scrollbar-track { background: var(--p-black); }
      ::-webkit-scrollbar-thumb { background: var(--p-line); }
      ::-webkit-scrollbar-thumb:hover { background: var(--p-accent); }

      /* ── Focus ── */
      :focus-visible { outline: 1px solid var(--p-accent); outline-offset: 3px; }

      /* ── Body ── */
      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.04rem;
        line-height: calc(1 + 0.8 / var(--font-body-scale));
        font-family: var(--p-font-sans);
        font-weight: 300;
        color: var(--p-text-2);
        background-color: var(--p-deep);
        -webkit-font-smoothing: antialiased;
        cursor: crosshair;
        /* Anxious grain — always present */
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.048'/%3E%3C/svg%3E");
      }

      @media screen and (min-width: 750px) { body { font-size: 1.6rem; } }

      a, button, [role="button"], select, label[for] { cursor: pointer; }
      a { color: inherit; text-decoration: none; transition: color var(--p-t-mid) var(--p-ease-mid); }
      a:hover { color: var(--p-text-1); }

      /* ── Headings — Cormorant, large, commanding ── */
      h1, h2, h3, h4, h5, h6,
      .h0, .h1, .h2, .h3, .h4, .h5, .h6 {
        font-family: var(--p-font-serif) !important;
        font-weight: 400;
        letter-spacing: 0.1em;
        color: var(--p-text-1) !important;
        line-height: 1.05;
      }

      /* ── Gradient body class override ── */
      .gradient {
        background-color: var(--p-deep);
        background-image:
          radial-gradient(ellipse 90% 45% at 25% -5%, rgba(35, 31, 48, 0.6) 0%, transparent 65%),
          radial-gradient(ellipse 55% 35% at 85% 100%, rgba(13, 11, 16, 0.7) 0%, transparent 60%),
          url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.048'/%3E%3C/svg%3E");
      }

      /* ── Global border-radius override — ZERO everywhere ── */
      *, *::before, *::after { border-radius: 0 !important; }
      /* Allow circles where needed (e.g. cart count) */
      .cart-count-bubble { border-radius: 50% !important; }

      /* ── Buttons ── */
      .button, button:not([class]), input[type="submit"] {
        font-family: var(--p-font-mono) !important;
        font-weight: 400 !important;
        letter-spacing: 0.2em !important;
        text-transform: uppercase !important;
        font-size: 0.88rem !important;
        transition:
          background-color var(--p-t-mid) var(--p-ease-mid),
          color var(--p-t-mid) var(--p-ease-mid),
          border-color var(--p-t-mid) var(--p-ease-mid),
          transform var(--p-t-fast) var(--p-ease-mid);
      }

      /* Primary — inverse: pale on void */
      .button--primary, .shopify-payment-button__button {
        background-color: var(--p-text-1) !important;
        color: var(--p-black) !important;
        border: 1px solid var(--p-text-1) !important;
        padding: 1.6rem 3.2rem !important;
      }
      .button--primary:hover, .shopify-payment-button__button:hover {
        background-color: var(--p-accent) !important;
        border-color: var(--p-accent) !important;
        transform: translateY(-1px);
      }

      /* Secondary — ghost */
      .button--secondary {
        background-color: transparent !important;
        color: var(--p-text-3) !important;
        border: 1px solid var(--p-line) !important;
        padding: 1.6rem 3.2rem !important;
      }
      .button--secondary:hover {
        border-color: var(--p-text-3) !important;
        color: var(--p-text-2) !important;
      }

      /* ── Inputs ── */
      input[type="text"], input[type="email"], input[type="password"],
      input[type="search"], input[type="tel"], input[type="number"],
      textarea, select {
        background-color: var(--p-surface) !important;
        color: var(--p-text-2) !important;
        border-color: var(--p-line) !important;
        font-family: var(--p-font-sans) !important;
        font-weight: 300 !important;
        letter-spacing: 0.04em !important;
        caret-color: var(--p-accent);
        transition: border-color var(--p-t-mid) var(--p-ease-mid);
      }
      input:focus, textarea:focus, select:focus {
        border-color: var(--p-accent) !important;
        outline: none !important;
        box-shadow: 0 0 0 1px var(--p-accent-dim) !important;
      }

      /* ── Cards — Gucci precision: rectangular, minimal ── */
      .card-wrapper {
        position: relative;
        background-color: var(--p-surface);
      }
      .card-wrapper, .card {
        border-color: var(--p-line) !important;
        transition:
          border-color var(--p-t-mid) var(--p-ease-mid),
          box-shadow var(--p-t-mid) var(--p-ease-mid),
          transform var(--p-t-mid) var(--p-ease-out);
      }
      .card-wrapper:hover .card, .card:hover {
        border-color: var(--p-muted) !important;
        box-shadow: 0 12px 48px rgba(0,0,0,0.65);
        transform: translateY(-4px);
      }

      /* Specimen pin-hole — top right, shifts to accent on hover */
      .card-wrapper::after {
        content: '';
        position: absolute;
        top: 10px; right: 10px;
        width: 4px; height: 4px;
        border-radius: 50% !important;
        background-color: var(--p-line);
        z-index: 2;
        transition: background-color var(--p-t-mid);
        pointer-events: none;
      }
      .card-wrapper:hover::after { background-color: var(--p-accent); }

      /* Product card titles */
      .card__heading a {
        font-family: var(--p-font-serif) !important;
        font-weight: 400 !important;
        letter-spacing: 0.06em !important;
        font-size: 1.55rem !important;
        color: var(--p-text-2) !important;
        transition: color var(--p-t-mid);
      }
      .card-wrapper:hover .card__heading a { color: var(--p-text-1) !important; }

      /* Product image: desaturated, unlocks on hover */
      .media img, .card__media img {
        transition: transform 1.6s var(--p-ease-out), filter 0.9s var(--p-ease-mid);
        filter: brightness(0.88) saturate(0.3) contrast(1.08);
      }
      .card-wrapper:hover .media img, .card-wrapper:hover .card__media img {
        transform: scale(1.05);
        filter: brightness(0.96) saturate(0.65) contrast(1.02);
      }

      /* ── Price ── */
      .price, .price__regular, .price__sale {
        font-family: var(--p-font-mono) !important;
        font-size: 1.0rem !important;
        letter-spacing: 0.12em !important;
        color: var(--p-text-3) !important;
        font-weight: 400 !important;
      }
      .badge {
        font-family: var(--p-font-mono) !important;
        font-size: 0.78rem !important;
        letter-spacing: 0.18em !important;
        text-transform: uppercase !important;
        font-weight: 400 !important;
      }
      .badge--sale {
        background-color: var(--p-bruise) !important;
        color: var(--p-text-3) !important;
        border: 1px solid var(--p-line) !important;
      }

      /* ── Header ── */
      .header-wrapper {
        background-color: var(--p-black) !important;
        border-bottom: 1px solid var(--p-line) !important;
        transition:
          background-color var(--p-t-slow) var(--p-ease-mid),
          border-color var(--p-t-slow),
          box-shadow var(--p-t-slow);
      }
      .shopify-section-header-sticky .header-wrapper {
        background-color: rgba(8, 7, 9, 0.97) !important;
        backdrop-filter: blur(18px) saturate(0.4);
        -webkit-backdrop-filter: blur(18px) saturate(0.4);
        border-bottom-color: var(--p-muted) !important;
        box-shadow: 0 1px 60px rgba(0,0,0,0.92);
      }

      /* ── Nav ── */
      .header__menu-item, .list-menu__item a {
        font-family: var(--p-font-mono) !important;
        font-weight: 400 !important;
        letter-spacing: 0.22em !important;
        text-transform: uppercase !important;
        font-size: 0.82rem !important;
        color: var(--p-text-4) !important;
        position: relative;
        transition: color var(--p-t-mid) var(--p-ease-mid) !important;
      }
      /* Gold-thread underline draw */
      .header__menu-item::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0; height: 1px;
        background: var(--p-accent);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.7s var(--p-ease-out);
      }
      .header__menu-item:hover::after { transform: scaleX(1); }
      .header__menu-item:hover { color: var(--p-text-2) !important; }
      .header__active-menu-item, [aria-current="page"] .header__active-menu-item { color: var(--p-accent) !important; }

      /* ── Submenus ── */
      .header__submenu, .disclosure__panel, .mega-menu__content {
        background-color: var(--p-raised) !important;
        border: 1px solid var(--p-line) !important;
        box-shadow: 0 24px 72px rgba(0,0,0,0.88) !important;
      }

      /* ── Drawers ── */
      cart-drawer, #CartDrawer { background-color: var(--p-raised) !important; border-left: 1px solid var(--p-line) !important; }
      .menu-drawer { background-color: var(--p-raised) !important; border-right: 1px solid var(--p-line) !important; }

      /* ── Search ── */
      predictive-search, .predictive-search {
        background-color: var(--p-raised) !important;
        border: 1px solid var(--p-line) !important;
        box-shadow: 0 24px 72px rgba(0,0,0,0.88) !important;
      }
      .predictive-search__item:hover { background-color: rgba(200,194,184,0.04) !important; }

      /* ── Cart count ── */
      .cart-count-bubble {
        background-color: var(--p-accent) !important;
        color: var(--p-black) !important;
        font-family: var(--p-font-mono) !important;
        font-size: 0.72rem !important;
      }

      /* ── Section colour classes ── */
      .color-background-1 { background-color: var(--p-deep) !important; color: var(--p-text-2) !important; }
      .color-background-2 { background-color: var(--p-surface) !important; color: var(--p-text-2) !important; }
      .color-accent-1 { background-color: var(--p-bruise) !important; color: var(--p-text-2) !important; }
      .color-accent-2 { background-color: var(--p-raised) !important; color: var(--p-text-2) !important; }
      .color-inverse { background-color: var(--p-text-1) !important; color: var(--p-black) !important; }

      /* ── Footer ── */
      .footer { background-color: var(--p-black) !important; border-top: 1px solid var(--p-line) !important; color: var(--p-text-4) !important; }
      .footer__heading { font-family: var(--p-font-mono) !important; font-size: 0.78rem !important; letter-spacing: 0.26em !important; text-transform: uppercase !important; color: var(--p-text-3) !important; }
      .footer a { color: var(--p-text-4); font-size: 1.1rem; letter-spacing: 0.08em; }
      .footer a:hover { color: var(--p-accent); }

      /* ── Announcement bar ── */
      .announcement-bar { background-color: var(--p-black) !important; border-bottom: 1px solid var(--p-line) !important; }
      .announcement-bar__message { font-family: var(--p-font-mono) !important; font-size: 0.82rem !important; letter-spacing: 0.24em !important; text-transform: uppercase !important; color: var(--p-text-3) !important; }

      /* ── Variant pills ── */
      .swatch__label, .variant-pills__label {
        font-family: var(--p-font-mono) !important;
        font-size: 0.88rem !important; letter-spacing: 0.12em !important;
        background-color: transparent !important; color: var(--p-text-4) !important;
        border: 1px solid var(--p-line) !important;
        transition: all var(--p-t-mid) var(--p-ease-mid);
        min-width: 4rem; text-align: center;
      }
      .swatch__label:hover, .variant-pills__label:hover { border-color: var(--p-muted) !important; color: var(--p-text-3) !important; }
      .swatch__input:checked + .swatch__label,
      .variant-pills__input:checked + .variant-pills__label {
        border-color: var(--p-accent) !important;
        color: var(--p-text-1) !important;
        background-color: var(--p-accent-dim) !important;
      }

      /* ── Quantity ── */
      .quantity { border: 1px solid var(--p-line) !important; background-color: var(--p-surface) !important; transition: border-color var(--p-t-mid); }
      .quantity:focus-within { border-color: var(--p-accent) !important; }
      .quantity__input { color: var(--p-text-2) !important; background: transparent !important; font-family: var(--p-font-mono) !important; }
      .quantity__button { color: var(--p-dim) !important; transition: color var(--p-t-mid); }
      .quantity__button:hover { color: var(--p-accent) !important; }

      /* ── Spinner ── */
      .loading-overlay__spinner .path, .spinner .path { stroke: var(--p-accent) !important; }

      /* ── Header icons ── */
      .header__icon { color: var(--p-text-4) !important; transition: color var(--p-t-mid) var(--p-ease-mid) !important; }
      .header__icon:hover { color: var(--p-text-2) !important; }

      /* ══════════════════════════════════════════════════════
         PALLØR — THE BROKEN MOTH ENTRANCE
         "Drawn to light, even when it burns."

         One wing intact. One wing torn.
         The moth descends with full authority.
         It does not apologise for the tear.
         It never corrects itself.
         It keeps flying.

         Session-gated. In design mode: skipped automatically.
         Tap anywhere to enter early.
      ══════════════════════════════════════════════════════ */

      #pallor-intro {
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: all;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: var(--p-black);
        /* Same grain as the site — continuity */
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.07'/%3E%3C/svg%3E");
        animation: pallor-screen-fade 0.8s 4.8s var(--p-ease-in) forwards;
      }
      @keyframes pallor-screen-fade { to { opacity: 0; pointer-events: none; } }

      /* The moth — larger, more imposing on a luxury site */
      #pallor-moth {
        width: min(55vw, 440px);
        height: auto;
        /* Cold diffused glow — no warmth */
        filter:
          drop-shadow(0 0 35px rgba(200, 194, 184, 0.20))
          drop-shadow(0 0 80px rgba(200, 194, 184, 0.06));
        animation:
          pallor-moth-descend 2.2s var(--p-ease-out) forwards,
          pallor-moth-flutter  0.8s 2.2s ease-in-out 2,
          pallor-moth-ascend   1.1s 4.0s var(--p-ease-in) forwards;
        opacity: 0;
        transform-origin: center top;
        will-change: transform, opacity;
      }

      @keyframes pallor-moth-descend {
        0%   { opacity: 0;   transform: translateY(-140px) scale(0.75) rotate(-5deg); }
        25%  { opacity: 0.6; }
        100% { opacity: 1;   transform: translateY(0) scale(1) rotate(0deg); }
      }

      /* Asymmetric flutter — the torn wing can't match the intact side */
      @keyframes pallor-moth-flutter {
        0%   { transform: translateY(0) scaleX(1) rotate(0deg); }
        18%  { transform: translateY(-12px) scaleX(0.91) rotate(-4deg); }  /* torn side fights */
        38%  { transform: translateY(-3px) scaleX(0.97) rotate(1deg); }
        58%  { transform: translateY(-9px) scaleX(0.93) rotate(-3deg); }
        78%  { transform: translateY(-4px) scaleX(0.98) rotate(0.5deg); }
        100% { transform: translateY(0) scaleX(1) rotate(0deg); }
      }

      @keyframes pallor-moth-ascend {
        0%   { opacity: 1; transform: translateY(0) scale(1); }
        100% { opacity: 0; transform: translateY(-180px) scale(0.55); filter: none; }
      }

      /* PALLØR wordmark — letter-spacing compresses in, then glitch */
      #pallor-wordmark {
        position: absolute;
        bottom: 33%;
        left: 50%;
        transform: translateX(-50%);
        font-family: var(--p-font-serif);
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 300;
        letter-spacing: 0.55em;
        text-transform: uppercase;
        color: var(--p-text-3);
        opacity: 0;
        white-space: nowrap;
        animation:
          pallor-wordmark-in 1.0s 2.4s var(--p-ease-out) forwards,
          pallor-glitch       0.16s 3.2s steps(2) 1;
      }
      @keyframes pallor-wordmark-in {
        from { opacity: 0; letter-spacing: 0.9em; }
        to   { opacity: 1; letter-spacing: 0.55em; }
      }
      /* The glitch — the brand flickers once, then settles into itself */
      @keyframes pallor-glitch {
        0%  {
          clip-path: polygon(0 0, 100% 0, 100% 40%, 0 40%);
          transform: translateX(-50%) translateX(6px);
        }
        50% {
          clip-path: polygon(0 58%, 100% 58%, 100% 100%, 0 100%);
          transform: translateX(-50%) translateX(-5px);
        }
        100% {
          clip-path: none;
          transform: translateX(-50%);
        }
      }

      /* Brand line — manifesto fragment */
      #pallor-tagline {
        position: absolute;
        bottom: 26.5%;
        left: 50%;
        transform: translateX(-50%);
        font-family: var(--p-font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--p-text-4);
        opacity: 0;
        white-space: nowrap;
        animation: pallor-fade-in 0.7s 3.2s var(--p-ease-mid) forwards;
      }
      #pallor-enter {
        position: absolute;
        bottom: 5.5%;
        left: 50%;
        transform: translateX(-50%);
        font-family: var(--p-font-mono);
        font-size: 0.65rem;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        color: var(--p-text-4);
        opacity: 0;
        white-space: nowrap;
        animation: pallor-fade-in 0.5s 3.0s var(--p-ease-mid) forwards;
      }
      @keyframes pallor-fade-in { from { opacity: 0; } to { opacity: 1; } }

      /* ── Scroll moth — background presence ── */
      #pallor-bg-moth {
        position: fixed;
        bottom: -18vh;
        right: -14vw;
        width: min(65vw, 620px);
        height: auto;
        pointer-events: none;
        z-index: 0;
        opacity: 0.018;
        filter: grayscale(1) brightness(0.6) contrast(1.3);
        will-change: transform;
      }

      /* ── Main content rise ── */
      @keyframes pallor-rise {
        from { opacity: 0; transform: translateY(22px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      #MainContent {
        animation: pallor-rise 1.2s 5.1s var(--p-ease-out) both;
      }

      /* ── Skip link ── */
      .skip-to-content-link {
        background: var(--p-accent);
        color: var(--p-black);
        font-family: var(--p-font-mono);
        font-size: 0.82rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        z-index: 10000;
      }

      /* ── Reduced motion ── */
      @media (prefers-reduced-motion: reduce) {
        #pallor-intro { display: none !important; }
        #pallor-bg-moth { display: none !important; }
        #MainContent { animation: none !important; opacity: 1 !important; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    {% endstyle %}

