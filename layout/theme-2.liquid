              stroke-linecap="round" stroke-dasharray="2 1.8" opacity="0.28"/>
        <circle cx="279" cy="85" r="2" fill="#c8c2b8" opacity="0.32"/>
      </svg>

      <!-- Brand wordmark with glitch -->
      <span id="pallor-wordmark" aria-hidden="true">PALLØR</span>

      <!-- Manifesto fragment -->
      <span id="pallor-tagline" aria-hidden="true">not perfection. the rejection of it.</span>

      <!-- Enter hint -->
      <span id="pallor-enter" aria-hidden="true">tap to enter</span>
    </div>

    <!-- Persistent background moth — scroll-driven parallax -->
    <svg id="pallor-bg-moth" viewBox="0 0 480 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation">
      <path d="M240 178 C210 140,142 92,75 76 C42 68,18 80,24 104 C30 128,70 141,106 148 C148 157,198 169,240 178Z" fill="#c8c2b8"/>
      <path d="M240 178 C270 140,330 96,385 82 C410 75,430 84,428 106 C427 117,410 133,382 141 C360 144,340 139,318 140 C296 136,270 138,245 145 C242 146,241 162,240 178Z" fill="#c8c2b8" opacity="0.72"/>
      <path d="M240 178 C212 193,148 208,84 234 C50 248,26 264,38 282 C50 300,92 294,134 278 C178 261,214 222,240 178Z" fill="#c8c2b8" opacity="0.80"/>
      <path d="M240 178 C264 193,308 208,356 228 C386 242,406 258,394 274 C382 290,346 284,308 268 C266 250,244 218,240 178Z" fill="#c8c2b8" opacity="0.60"/>
