  <body class="gradient">

    <!-- ══════════════════════════════════════════════════════
         PALLØR — THE BROKEN MOTH
         "Imperfection is not something to fix."

         Left wing: intact. Right wing: torn, ragged.
         Left antenna: complete. Right antenna: broken at tip.
         The asymmetry is permanent. It is the brand.
    ══════════════════════════════════════════════════════ -->
    <div id="pallor-intro" aria-hidden="true" role="presentation">

      <svg id="pallor-moth" viewBox="0 0 480 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <!-- Left wing: cold, pale, intact -->
          <radialGradient id="lw" cx="32%" cy="48%" r="68%">
            <stop offset="0%"   stop-color="#ddd8d0" stop-opacity="0.90"/>
            <stop offset="35%"  stop-color="#9a96a8" stop-opacity="0.70"/>
            <stop offset="75%"  stop-color="#3a3648" stop-opacity="0.45"/>
            <stop offset="100%" stop-color="#1e1c2a" stop-opacity="0.20"/>
          </radialGradient>
          <!-- Right wing: dimmer, torn side -->
          <radialGradient id="rw" cx="68%" cy="48%" r="68%">
            <stop offset="0%"   stop-color="#c8c2b8" stop-opacity="0.78"/>
            <stop offset="35%"  stop-color="#7a7688" stop-opacity="0.58"/>
            <stop offset="75%"  stop-color="#2e2b3e" stop-opacity="0.38"/>
            <stop offset="100%" stop-color="#1e1c2a" stop-opacity="0.15"/>
          </radialGradient>
        </defs>

        <!-- ── LEFT UPPER WING — intact, graceful sweep ── -->
        <path d="M240 178
                 C210 140, 142 92, 75 76
                 C42 68, 18 80, 24 104
                 C30 128, 70 141, 106 148
                 C148 157, 198 169, 240 178 Z"
              fill="url(#lw)" opacity="0.92"/>

        <!-- Left upper wing veins -->
        <g stroke="#ddd8d0" stroke-width="0.85" fill="none" opacity="0.26">
          <path d="M240 178 C206 150,154 116,90 92"/>
          <path d="M235 175 C200 148,146 116,80 102"/>
          <path d="M232 178 C190 164,142 142,82 126"/>
          <path d="M237 182 C195 178,150 172,98 162"/>
        </g>

        <!-- ── RIGHT UPPER WING — TORN. Jagged edge, missing section ── -->
        <path d="M240 178
                 C270 140, 330 96, 385 82
                 C410 75, 430 84, 428 106
                 C427 117, 420 126, 410 133
                 C402 138, 392 140, 382 141
                 C374 142, 368 145, 360 144
                 C352 143, 348 140, 340 139
                 C332 139, 326 142, 318 140
                 C308 138, 304 134, 296 136
                 C288 138, 285 142, 277 140
                 C270 138, 267 134, 260 136
                 C254 138, 251 143, 245 145
                 C242 146, 241 162, 240 178 Z"
              fill="url(#rw)" opacity="0.80"/>

        <!-- Right wing veins — fewer, ending short -->
        <g stroke="#c8c2b8" stroke-width="0.75" fill="none" opacity="0.20">
          <path d="M240 178 C274 152,314 122,360 100"/>
          <path d="M246 175 C278 150,318 122,362 106"/>
          <path d="M250 178 C282 164,322 146,368 130"/>
        </g>

        <!-- Torn edge — ragged strokes where wing was lost -->
        <g stroke="#c8c2b8" stroke-width="1.0" fill="none" opacity="0.28" stroke-linecap="round">
          <line x1="382" y1="141" x2="390" y2="150"/>
          <line x1="368" y1="141" x2="374" y2="151"/>
          <line x1="352" y1="140" x2="357" y2="150"/>
          <line x1="338" y1="139" x2="342" y2="149"/>
          <line x1="322" y1="140" x2="325" y2="149"/>
          <line x1="308" y1="138" x2="310" y2="147"/>
        </g>

        <!-- ── LEFT LOWER WING — intact ── -->
        <path d="M240 178
                 C212 193, 148 208, 84 234
                 C50 248, 26 264, 38 282
                 C50 300, 92 294, 134 278
                 C178 261, 214 222, 240 178 Z"
              fill="url(#lw)" opacity="0.74"/>

        <g stroke="#ddd8d0" stroke-width="0.7" fill="none" opacity="0.20">
          <path d="M240 178 C200 200,144 222,82 252"/>
          <path d="M235 185 C192 205,136 230,70 262"/>
        </g>

        <!-- ── RIGHT LOWER WING — smaller, irregular, broken side ── -->
        <path d="M240 178
                 C264 193, 308 208, 356 228
                 C386 242, 406 258, 394 274
                 C382 290, 346 284, 308 268
                 C266 250, 244 218, 240 178 Z"
              fill="url(#rw)" opacity="0.64"/>

        <g stroke="#c8c2b8" stroke-width="0.65" fill="none" opacity="0.16">
          <path d="M240 178 C272 198,312 218,358 242"/>
        </g>

        <!-- Left eyespot — present, cold -->
        <circle cx="118" cy="130" r="6" fill="#c8c2b8" opacity="0.18"/>
        <circle cx="118" cy="130" r="2.8" fill="#eae6df" opacity="0.35"/>

        <!-- Right eyespot — partially torn away -->
        <circle cx="364" cy="128" r="4.5" fill="#c8c2b8" opacity="0.10"/>

        <!-- Body — thin, precise -->
        <ellipse cx="240" cy="186" rx="5.5" ry="36"
                 fill="#0d0b10" stroke="#c8c2b8" stroke-width="0.65" opacity="0.95"/>
        <g stroke="#c8c2b8" stroke-width="0.4" opacity="0.28">
          <line x1="234.5" y1="193" x2="245.5" y2="193"/>
          <line x1="234.5" y1="202" x2="245.5" y2="202"/>
          <line x1="235.5" y1="211" x2="244.5" y2="211"/>
        </g>

        <!-- Head -->
        <circle cx="240" cy="150" r="7.5"
                fill="#0d0b10" stroke="#c8c2b8" stroke-width="0.65" opacity="0.95"/>
        <circle cx="236" cy="148" r="2.0" fill="#c8c2b8" opacity="0.68"/>
        <circle cx="244" cy="148" r="2.0" fill="#c8c2b8" opacity="0.68"/>

        <!-- Left antenna — intact, elegant -->
        <path d="M236 142 C224 122, 208 107, 188 92"
              stroke="#c8c2b8" stroke-width="1.2" fill="none"
              stroke-linecap="round" opacity="0.60"/>
        <circle cx="188" cy="92" r="2.8" fill="#c8c2b8" opacity="0.65"/>

