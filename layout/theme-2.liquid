        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      };
      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`
      };
      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`
      };
    </script>

    <script>
      (function () {
        var intro = document.getElementById('pallor-intro');
        var bgMoth = document.getElementById('pallor-bg-moth');

        /* ── Session-gated intro ── */
        if (intro) {
          var inDesign = document.documentElement.classList.contains('shopify-design-mode');
          var seen = sessionStorage.getItem('pallor-v3-seen');

          if (inDesign || seen) {
            intro.style.display = 'none';
            /* If skipping intro, still show main content immediately */
            var main = document.getElementById('MainContent');
            if (main) { main.style.animation = 'none'; main.style.opacity = '1'; }
          } else {
            /* Auto-hide after all animations complete */
            setTimeout(function () {
              sessionStorage.setItem('pallor-v3-seen', '1');
              intro.style.display = 'none';
            }, 5700);

            /* Tap anywhere to enter early */
            intro.addEventListener('click', function () {
              intro.style.transition = 'opacity 0.45s ease';
              intro.style.opacity = '0';
              setTimeout(function () {
                intro.style.display = 'none';
                sessionStorage.setItem('pallor-v3-seen', '1');
              }, 450);
            }, { once: true });
          }
        }

        /* ── Scroll parallax: moth drifts upward against scroll ── */
        if (bgMoth && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          var ticking = false;
          window.addEventListener('scroll', function () {
            if (!ticking) {
              requestAnimationFrame(function () {
                var y = window.pageYOffset;
                bgMoth.style.transform = 'translateY(-' + (y * 0.16) + 'px) rotate(' + (y * 0.005) + 'deg)';
                bgMoth.style.opacity   = Math.min(0.048, 0.010 + (y / 2800) * 0.038);
                ticking = false;
              });
              ticking = true;
            }
          }, { passive: true });
        }
      })();
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script
      src="https://code.jquery.com/jquery-3.7.1.min.js"
      integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
      crossorigin="anonymous"
      defer
    ></script>
  </body>
